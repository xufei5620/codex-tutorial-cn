{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codex-tutorial.local/schemas/framework-v1.schema.json",
  "title": "Codex tutorial framework registry",
  "description": "校验 registry/framework-v1.json（由 src/build.py 从 src/maintainer/framework-v1.json 生成）。只约束结构与枚举，不把标题等自由文本钉死，日常更新状态无需改 schema。",
  "type": "object",
  "required": [
    "frameworkVersion",
    "contentVersion",
    "artifactVersion",
    "status",
    "frameworkDefinitionStatus",
    "catalogStatus",
    "authority",
    "audience",
    "platforms",
    "scope",
    "chapters",
    "extensionCatalog",
    "promptLibrary",
    "contentStatus",
    "sourceRights",
    "verification",
    "notion",
    "publishing",
    "releaseGate",
    "currentSeedContent"
  ],
  "properties": {
    "frameworkVersion": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "contentVersion": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "artifactVersion": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "status": {
      "enum": [
        "framework-review",
        "draft-seed-unverified",
        "review-in-progress",
        "acceptance-ready",
        "stable",
        "retired"
      ]
    },
    "frameworkDefinitionStatus": {
      "description": "Lifecycle of the framework definition before the generated registry projects the catalog status into the legacy status field.",
      "enum": [
        "framework-review",
        "draft-seed-unverified",
        "review-in-progress",
        "acceptance-ready",
        "stable",
        "retired"
      ]
    },
    "catalogStatus": {
      "description": "Current content catalog lifecycle projected into a generated framework registry.",
      "enum": [
        "draft-seed-unverified",
        "review-in-progress",
        "acceptance-ready",
        "stable",
        "retired"
      ]
    },
    "generatedDate": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "productNote": {
      "type": "string"
    },
    "authority": {
      "type": "object",
      "required": [
        "canonicalSource",
        "generatedArtifacts",
        "github"
      ],
      "properties": {
        "canonicalSource": {
          "type": "object",
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "enum": [
                "local-git"
              ]
            },
            "remoteRequired": {
              "type": "boolean"
            }
          }
        },
        "generatedArtifacts": {
          "type": "object",
          "properties": {
            "htmlAndMetadataAreNormative": {
              "const": true
            },
            "zipIsImmutableSnapshot": {
              "type": "boolean"
            },
            "notionIsAuthority": {
              "const": false
            }
          }
        },
        "github": {
          "type": "object",
          "required": [
            "publishFrom",
            "requiresUserAcceptance"
          ],
          "properties": {
            "phase": {
              "type": "string"
            },
            "visibility": {
              "type": "string"
            },
            "publishFrom": {
              "const": "approved-public-whitelist-tree"
            },
            "includeFullLocalHistory": {
              "const": false
            },
            "requiresUserAcceptance": {
              "const": true
            }
          }
        }
      }
    },
    "audience": {
      "type": "object",
      "required": [
        "primary",
        "language"
      ],
      "properties": {
        "primary": {
          "type": "string"
        },
        "assumedKnowledge": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "language": {
          "const": "zh-CN"
        },
        "teachingStyle": {
          "type": "string"
        }
      }
    },
    "platforms": {
      "type": "object",
      "required": [
        "included",
        "excluded"
      ],
      "properties": {
        "included": {
          "type": "array",
          "items": {
            "enum": [
              "windows",
              "macos"
            ]
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "sharedContentKey": {
          "type": "string"
        },
        "excluded": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "scope": {
      "type": "object",
      "required": [
        "include",
        "exclude",
        "delivery"
      ],
      "properties": {
        "include": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "exclude": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "delivery": {
          "type": "object",
          "required": [
            "primary",
            "networkRequired",
            "serverRequired"
          ],
          "properties": {
            "primary": {
              "const": "offline-multi-file-semantic-html"
            },
            "runtime": {
              "type": "string"
            },
            "networkRequired": {
              "const": false
            },
            "serverRequired": {
              "const": false
            }
          }
        }
      }
    },
    "chapters": {
      "type": "array",
      "minItems": 11,
      "maxItems": 11,
      "items": {
        "$ref": "#/$defs/chapter"
      }
    },
    "extensionCatalog": {
      "type": "object",
      "required": [
        "directoryRules",
        "plugin",
        "skill"
      ],
      "properties": {
        "directoryRules": {
          "type": "object",
          "properties": {
            "oneObjectPerDirectory": {
              "const": true
            },
            "displayNameStoredInMetadata": {
              "type": "boolean"
            },
            "packageRedistribution": {
              "const": "owned-or-explicitly-permitted-only"
            },
            "maintainerPublished": {
              "type": "boolean"
            }
          }
        },
        "plugin": {
          "$ref": "#/$defs/extensionKind"
        },
        "skill": {
          "$ref": "#/$defs/extensionKind"
        }
      }
    },
    "promptLibrary": {
      "type": "object",
      "required": [
        "navigation",
        "collections",
        "taskKeys",
        "uniqueCardCount",
        "placementCount"
      ],
      "properties": {
        "navigation": {
          "const": "independent-not-chapter-12"
        },
        "collections": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "key",
              "title",
              "idPrefix",
              "uniqueCardCount"
            ],
            "properties": {
              "key": {
                "type": "string",
                "pattern": "^prompt-[a-z-]+$"
              },
              "title": {
                "type": "string"
              },
              "idPrefix": {
                "type": "string",
                "pattern": "^[A-Z]{3}$"
              },
              "uniqueCardCount": {
                "type": "integer",
                "minimum": 0
              },
              "usesSharedFileCard": {
                "type": "boolean"
              },
              "status": {
                "type": "string"
              },
              "draftedCards": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        },
        "taskKeys": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "uniqueCardCount": {
          "type": "integer",
          "minimum": 0
        },
        "placementCount": {
          "type": "integer",
          "minimum": 0
        },
        "sharedCard": {
          "type": "object",
          "required": [
            "id",
            "taskKey"
          ],
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^PRM-[A-Z]+-[0-9]{4}$"
            },
            "taskKey": {
              "type": "string"
            },
            "placementCollections": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "placementCount": {
              "type": "integer",
              "minimum": 0
            }
          }
        }
      }
    },
    "contentStatus": {
      "type": "object",
      "required": [
        "pipeline",
        "transitionRule"
      ],
      "properties": {
        "pipeline": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/pipelineState"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "transitionRule": {
          "type": "string"
        },
        "singleMaintainerReviewSubstitute": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "sourceRights": {
      "type": "object",
      "required": [
        "publicAllowed",
        "publicBlocked",
        "rules"
      ],
      "properties": {
        "publicAllowed": {
          "type": "array",
          "items": {
            "enum": [
              "owned",
              "cleared",
              "link-only"
            ]
          },
          "uniqueItems": true
        },
        "publicBlocked": {
          "type": "array",
          "items": {
            "enum": [
              "unknown",
              "conflict",
              "pending"
            ]
          },
          "uniqueItems": true
        },
        "rules": {
          "type": "object"
        }
      }
    },
    "verification": {
      "type": "object",
      "required": [
        "states",
        "riskRevalidationDays"
      ],
      "properties": {
        "states": {
          "type": "array",
          "items": {
            "enum": [
              "verified",
              "verified-with-limitations",
              "verification-failed",
              "unverified",
              "unsupported",
              "verification-expired"
            ]
          },
          "uniqueItems": true
        },
        "riskRevalidationDays": {
          "type": "object",
          "required": [
            "high",
            "medium",
            "low"
          ],
          "properties": {
            "high": {
              "type": "integer",
              "minimum": 1
            },
            "medium": {
              "type": "integer",
              "minimum": 1
            },
            "low": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "conflictRule": {
          "type": "string"
        }
      }
    },
    "notion": {
      "type": "object",
      "required": [
        "direction",
        "authority",
        "v1Action"
      ],
      "properties": {
        "direction": {
          "const": "git-to-notion-only"
        },
        "authority": {
          "const": false
        },
        "v1Action": {
          "enum": [
            "local-preview-only",
            "deferred",
            "active"
          ]
        },
        "deferredDate": {
          "type": "string"
        },
        "deferredReason": {
          "type": "string"
        },
        "fields": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "publishSwitch": {
          "type": "string"
        }
      }
    },
    "publishing": {
      "type": "object",
      "required": [
        "github"
      ],
      "properties": {
        "github": {
          "type": "object",
          "required": [
            "visibility",
            "afterAcceptance"
          ],
          "properties": {
            "visibility": {
              "const": "public"
            },
            "afterAcceptance": {
              "const": true
            },
            "sourceTree": {
              "const": "approved-public-whitelist-tree"
            }
          }
        }
      }
    },
    "releaseGate": {
      "type": "object",
      "required": [
        "currentDecision",
        "requiredBeforeStable"
      ],
      "properties": {
        "currentDecision": {
          "enum": [
            "course-beta-in-development",
            "course-acceptance-pending",
            "course-stable-approved",
            "course-retired"
          ]
        },
        "requiredBeforeStable": {
          "const": [
            "framework-user-approved",
            "all-required-content-acceptance-ready",
            "source-and-rights-clear",
            "required-platform-verification-complete",
            "offline-build-and-links-pass",
            "accessibility-and-safety-gates-pass",
            "release-artifacts-reproducible"
          ]
        },
        "publicActionsBeforeAcceptance": {
          "const": false
        }
      }
    },
    "currentSeedContent": {
      "type": "object",
      "required": [
        "designation",
        "final",
        "countsAsCompletedCourseContent"
      ],
      "properties": {
        "designation": {
          "type": "string"
        },
        "final": {
          "type": "boolean"
        },
        "countsAsCompletedCourseContent": {
          "type": "boolean"
        },
        "reviewPolicy": {
          "type": "string"
        },
        "note": {
          "type": "string"
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "stable"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "releaseGate": {
            "properties": {
              "currentDecision": {
                "const": "course-stable-approved"
              }
            }
          },
          "currentSeedContent": {
            "required": [
              "designation",
              "final",
              "countsAsCompletedCourseContent",
              "reviewPolicy"
            ],
            "properties": {
              "designation": {
                "const": "formal-course"
              },
              "final": {
                "const": true
              },
              "countsAsCompletedCourseContent": {
                "const": true
              },
              "reviewPolicy": {
                "const": "accepted-item-by-item"
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "pipelineState": {
      "enum": [
        "outline",
        "draft",
        "source-and-rights-review",
        "editorial-reviewed",
        "verification",
        "acceptance-ready",
        "stable",
        "retired"
      ]
    },
    "chapter": {
      "type": "object",
      "required": [
        "number",
        "title",
        "status"
      ],
      "properties": {
        "number": {
          "type": "integer",
          "minimum": 1,
          "maximum": 11
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "outline",
            "draft",
            "source-and-rights-review",
            "editorial-reviewed",
            "verification",
            "acceptance-ready",
            "stable",
            "retired"
          ]
        },
        "file": {
          "type": "string",
          "pattern": "^ch[0-9]{2}\\.html$"
        },
        "summary": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "extensionKind": {
      "type": "object",
      "required": [
        "root",
        "requiredSubdirectories",
        "readerSectionKeys"
      ],
      "properties": {
        "root": {
          "type": "string"
        },
        "basicsReader": {
          "type": "string"
        },
        "objectDirectoryPattern": {
          "type": "string"
        },
        "requiredSubdirectories": {
          "type": "array",
          "items": {
            "enum": [
              "reader",
              "package",
              "maintainer"
            ]
          },
          "minItems": 3,
          "maxItems": 3,
          "uniqueItems": true
        },
        "readerSectionKeys": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        }
      }
    }
  }
}
